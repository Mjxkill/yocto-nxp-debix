[Unit]
Description=TAC5212 boot-time reset
After=sound.target
Wants=sound.target

[Service]
Type=oneshot
# Wait for SOF firmware loaded, card registered, and driver fully initialized
ExecStartPre=/bin/sleep 10
# Open a short capture stream to start BCLK, then tac-reset
ExecStart=/bin/sh -c 'arecord -D hw:2,0 -c 8 -f S32_LE -r 48000 -d 3 /tmp/tac_init.wav >/dev/null 2>&1 & sleep 1 && /usr/bin/tac-reset && wait'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
