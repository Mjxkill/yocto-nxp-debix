[Unit]
Description=V7.0-E6.c ALSA route bridge (matrice N×M via alsaloop)
After=sound.target snd-aloop-phone.service usb-uac2-gadget.service
Documentation=file:///etc/alsa-route-bridge.conf

[Service]
Type=forking
ExecStart=/usr/bin/alsa-route-start.sh
ExecStop=/usr/bin/alsa-route-stop.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
