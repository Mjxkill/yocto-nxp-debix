[Unit]
Description=V10 Mixer Console kiosk (chromium --kiosk sur ecran DSI 1024x600)
After=weston.service mixer-gui-http.service
Requires=weston.service
Wants=mixer-gui-http.service

[Service]
# ARCHI V10 §5 : cores 0-1, jamais le core audio ; cgroup memoire dur.
CPUAffinity=0 1
Nice=10
MemoryMax=400M
MemorySwapMax=0
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=WAYLAND_DISPLAY=wayland-1
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:8080/panel >/dev/null; do sleep 1; done'
ExecStart=/usr/bin/chromium --kiosk --no-sandbox \
    --ozone-platform=wayland \
    --window-size=1024,600 \
    --disable-features=TranslateUI \
    --noerrdialogs --disable-infobars --no-first-run \
    --enable-gpu-rasterization --ignore-gpu-blocklist \
    --autoplay-policy=no-user-gesture-required \
    http://localhost:8080/panel
Restart=on-failure
RestartSec=5
# Si OOM-kill par MemoryMax : redemarre (safe-mode geré côté page /panel)
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
