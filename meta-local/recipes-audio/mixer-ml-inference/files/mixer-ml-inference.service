[Unit]
Description=V9.5.12 mixer-ml-inference daemon (NPU mastering)
After=mixer-pro.service
Requires=mixer-pro.service
# V13.4 : PartOf → un restart de mixer-pro RELANCE aussi ce daemon.
# Sans lui, Requires arrêtait le daemon (exit 0) à chaque restart de
# mixer-pro SANS le redémarrer → mastering transparent (enveloppe NPU
# figée à 0), constaté 2026-07-11.
PartOf=mixer-pro.service

[Service]
Type=simple
ExecStart=/usr/bin/mixer-ml-inference /etc/mixer-pro/mastering_v5_20_int8.tflite
# Restart systématique (pas seulement on-failure) : si le daemon sort
# proprement pour une raison quelconque en live, il revient.
Restart=always
RestartSec=5s
# Process séparé non-RT (TFLite NPU dans même process que mixer-pro RT99
# = freeze kernel galcore vs ALSA SDMA). Pas de SCHED_FIFO.
Nice=10
# V10-N8 : core 0 uniquement — laisse le core 1 au QSGRenderThread de la
# console (mesure : ml-inf 13% en compétition avec le rendu = jank GUI)
CPUAffinity=0

[Install]
WantedBy=multi-user.target
