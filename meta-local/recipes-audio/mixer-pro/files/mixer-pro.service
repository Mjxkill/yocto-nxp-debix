[Unit]
Description=V8.0-E1 mixer-pro daemon (console DAW SW, 26 in / 4 bus FX / 18 out)
After=sound.target snd-aloop-phone.service usb-uac2-gadget.service
# V13.9 : Wants=mixer-ml-inference — le daemon NPU a PartOf=mixer-pro (le
# STOP le tue) mais PartOf ne propage pas le START : après un stop+start
# (déploiement), le daemon restait mort → enveloppe mastering figée à 0
# (régression NPU constatée 2026-07-13). Wants le remonte à chaque start.
Wants=usb-uac2-gadget.service mixer-ml-inference.service
Documentation=man:mixer-pro(8) file:///etc/alsa-route-bridge.conf

[Service]
Type=simple
ExecStartPre=/usr/bin/tac-reset analog
ExecStart=/usr/bin/mixer-pro --no-phone
TimeoutStartSec=30
Restart=on-failure
RestartSec=2

# RT capabilities
LimitRTPRIO=99
LimitMEMLOCK=infinity
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80

# V9.0 — cgroup ouvert à tous les cores 0-3 pour autoriser le pinning
# explicite par thread (pthread_setaffinity_np) :
#   - audio_thread + play_thread → core 2  (DSP path)
#   - cap_uac2_thread + play_uac2_thread → core 3 (USB path)
#   - analyzer_thread + control_thread → cores 0,1 (non-RT)
# isolcpus=2,3 dans bootargs garantit que cores 2,3 ne reçoivent que les
# threads pinned explicitement.
CPUAffinity=0 1 2 3

# Run as root (need SCHED_FIFO + mlockall + audio group)
User=root

[Install]
WantedBy=multi-user.target
