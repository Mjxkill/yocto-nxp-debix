[Unit]
Description=V7.0-E7 mixer-gui-http daemon (HTTP GUI for mixer-pro)
After=network.target mixer-pro.service
Wants=mixer-pro.service
Documentation=https://github.com/Mjxkill/yocto-nxp-debix

[Service]
Type=simple
ExecStart=/usr/bin/mixer-gui-http
Restart=on-failure
RestartSec=5
User=root

# V8.33 — cores non isolés pour ne pas polluer les cores audio (2,3)
# V10-N8 — core 0 uniquement : le core 1 est réservé au QSGRenderThread
# de la console native (mesure jank 2026-07-05)
CPUAffinity=0

[Install]
WantedBy=multi-user.target
