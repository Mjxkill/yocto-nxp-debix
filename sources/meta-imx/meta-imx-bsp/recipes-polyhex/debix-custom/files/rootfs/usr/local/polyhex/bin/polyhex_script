#!/bin/bash

# usb default set to host 
echo host > /sys/kernel/debug/usb/38100000.usb/mode

#add mount to fstab
BOOT_PATH=`mount | grep "on / type ext4" | awk '{print $1}'`
if [ "$BOOT_PATH" == "/dev/mmcblk1p2" ] ; then
mount /dev/mmcblk1p1 /boot
else
mount /dev/mmcblk2p1 /boot
fi

do_run_led(){
	while [ 1 ]
	do
			echo 1 > /sys/class/leds/yellow\:status/brightness
			sleep 0.5
			echo 0 > /sys/class/leds/yellow\:status/brightness
			sleep 0.5
	done
}
do_run_led &


### check bt
check_bt(){
	sleep 3 
	if [ -e /sys/class/net/mlan0 ] ; then
		killall hciattach
		systemctl stop bluetooth
		rfkill unblock all
		hciattach /dev/ttymxc0 any 115200 flow
		hciconfig hci0 up
		if [ $? != 0 ] ; then
			rfkill unblock all
			hciconfig hci0 up
		fi
		hcitool -i hci0 cmd 03f 0x009 0x80 0x84 0x1e 0x00
		killall hciattach
		hciattach /dev/ttymxc0 any 2000000 flow

		hciconfig hci0 up
		if [ $? != 0 ] ; then
			rfkill unblock all
			hciconfig hci0 up
		fi
		BT_RUN_TIME=0
		while [ 1 ]
		do
			if [ $BT_RUN_TIME -gt 3 ] ; then
				break;
			fi
			let BT_RUN_TIME+=1
			BT_ADDR=`hciconfig hci0 | grep "BD Address" | awk '{print $3}'`
			if [ "$BT_ADDR" = "00:00:00:00:00:00" ] ; then
				echo $BT_RUN_TIME > /home/debix/bt_try
				killall hciattach
				systemctl stop bluetooth
				rfkill unblock all
				sleep 1

				rmmod moal mlan
				sleep 1
				modprobe moal mod_para=nxp/wifi_mod_para.conf drvdbg=0x0
				sleep 1

				hciattach /dev/ttymxc0 any 115200 flow
				sleep 1
				BT_ADDR=`hciconfig hci0 | grep "BD Address" | awk '{print $3}'`
				if [ "$BT_ADDR" = "00:00:00:00:00:00" ] ; then
					continue;
				fi
				hciconfig hci0 up
				if [ $? != 0 ] ; then
					rfkill unblock all
					hciconfig hci0 up
				fi
				hcitool -i hci0 cmd 03f 0x009 0x80 0x84 0x1e 0x00
				killall hciattach
				hciattach /dev/ttymxc0 any 2000000 flow
				sleep 1
				hciconfig hci0 up
				if [ $? != 0 ] ; then
					rfkill unblock all
					hciconfig hci0 up
				fi
				sleep 1

			else
				break;
			fi
		done
		systemctl start bluetooth
	fi
}

set_hciattach(){
	BT_RUN_TIME=0
	while [ 1 ]
	do
		if [ $BT_RUN_TIME -gt 3 ] ; then
			break;
		fi
		let BT_RUN_TIME+=1
		/usr/bin/hciattach /dev/ttymxc0 bcm43xx -t120 3000000 flow
		sleep 3
		have_hci=`hciconfig hci0 | grep hci0`
		if [ "$have_hci" != "" ] ; then
			break;
		fi
	done
}

# first boot, expand sd card
if [ -f "/usr/local/polyhex/expand_sd_rootfs.sh" ]; then
	/usr/local/polyhex/expand_sd_rootfs.sh
	mv /usr/local/polyhex/expand_sd_rootfs.sh /usr/local/polyhex/expand_sd_rootfs_bak.sh
	#glib-compile-schemas /usr/share/glib-2.0/schemas
	reboot
else
	if [ -f /usr/sbin/DebixUpgrade ] ; then
		/usr/sbin/DebixUpgrade &
	fi

	### wait 10s for wifi ko insert
	sleep 10
	if [ ! -e /sys/class/net/wlan0 ] ; then
		modprobe moal mod_para=nxp/wifi_mod_para.conf drvdbg=0x0
		check_bt &
	else
		#date >> /root/123
		#lsmod | grep brcm >> /root/123
		set_hciattach &
	fi
fi

if [ -f "/usr/lib/systemd/system/psplash-start.service" ] ; then
	rm /usr/lib/systemd/system/psplash*
	rm /usr/bin/psplash*
fi

if [ -f "/usr/local/polyhex/es8316.store" ] ; then
	alsactl restore -f /usr/local/polyhex/es8316.store
	rm /usr/local/polyhex/es8316.store
fi

