[Unit]
Description=Debix adbd
After=rc-local.service

[Service]
#Restart=on-failure
User=root
ExecStart=-/usr/bin/su -c /usr/local/polyhex/bin/adb_enable
#NotifyAccess=main
#Restart=on-failure
#CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
#LimitNPROC=1
#ProtectHome=true
#ProtectSystem=full

[Install]
WantedBy=multi-user.target
